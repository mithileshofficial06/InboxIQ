# ============================================
# InboxIQ — Environment Variables
# ============================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to git — it's in .gitignore.
#
# Put ONLY placeholder values in this file. Real credentials were committed here
# once already and had to be rotated; treat anything written here as public.

# ============================================
# BACKEND SERVICE (.env at root)
# ============================================

# --- General ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# --- Supabase (https://supabase.com/dashboard/projects) ---
# The backend authenticates with the SERVICE ROLE key. The anon key is not used
# server-side and is only listed here for completeness.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# --- Redis/Upstash (https://console.upstash.com/redis) ---
# Hostname only — do NOT include the https:// prefix.
REDIS_HOST=your-redis-id.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# --- Session JWT (Generate: openssl rand -hex 32) ---
# REQUIRED. The server refuses to start on the built-in default, which is public.
JWT_SECRET=your_random_64_char_hex_string
JWT_EXPIRES_IN=12h

# --- Cookie (production only) ---
# Set when the frontend and API share a parent domain, e.g. ".inboxiq.app".
# COOKIE_DOMAIN=

# --- OAuth token encryption (Generate: openssl rand -base64 32) ---
# REQUIRED. Encrypts Google access/refresh tokens at rest. Must decode to
# exactly 32 bytes. Losing this key means every user must re-authenticate.
TOKEN_ENCRYPTION_KEY=your_base64_32_byte_key

# --- AI Microservice ---
AI_SERVICE_URL=http://localhost:8000
# REQUIRED. Shared secret authenticating this backend to the AI service.
# Must be identical to AI_SERVICE_TOKEN in ai-service/.env.
# Generate: openssl rand -base64 32
AI_SERVICE_TOKEN=your_shared_service_token

# --- NVIDIA NIM (https://build.nvidia.com) ---
NVIDIA_API_KEY=your_nvidia_api_key

# ============================================
# FRONTEND SERVICE (frontend/.env.local)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
# NOTE: there is deliberately no NEXT_PUBLIC_AI_URL. The AI service must never
# be reachable from the browser — it trusts whatever user_id it is given.
# All AI features are proxied through the backend.

# ============================================
# AI SERVICE (ai-service/.env)
# ============================================
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
NVIDIA_API_KEY=your_nvidia_api_key
# REQUIRED. Must match AI_SERVICE_TOKEN above exactly. The service refuses all
# requests when this is unset rather than running unauthenticated.
AI_SERVICE_TOKEN=your_shared_service_token
