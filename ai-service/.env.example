# InboxIQ AI Service — Environment Variables
# Copy this to .env and fill in your credentials.
# Placeholder values only — never put real secrets in this file.

# Database (same as backend)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# NVIDIA NIM API key (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key

# REQUIRED — shared secret proving the caller is the Express backend.
# Must match AI_SERVICE_TOKEN in the backend's .env exactly.
# Generate: openssl rand -base64 32
#
# This service trusts the user_id in every request body, so without this token
# anyone who can reach it can read or modify any user's email data. It refuses
# all requests when unset rather than running unauthenticated.
AI_SERVICE_TOKEN=your_shared_service_token

# Optional: Debug mode
DEBUG=false
