# InboxIQ Frontend — Environment Variables
# Copy this to .env.local and update values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# There is deliberately NO AI service URL here.
#
# The AI service trusts the user_id it is given, so calling it from the browser
# allowed any signed-in user to read any other user's inbox by changing one
# field. All AI features (semantic search, RAG chat) now go through the backend,
# which supplies the user id from the verified session cookie.
